.idea/
.venv/
data/*
!data/.gitkeep
# 例外：参考晶体结构文件（COD 公有领域、每个几 KB，供 tests / 示例 / 周报使用）
!data/structures/
outputs/
# outputs/ 是脚本的本地工作区（按数据文件名分文件夹，带运行编号），不上传
# （保护实验数据隐私）；README 展示用的精选图统一放在 showcase/ 里提交
# 样品派生的图/报告也只放本地：fit_lmfp/analyze_pattern 默认写 outputs/；
# showcase 里只留标样（LaB6）示例，样品图即使误生成也不进 git
showcase/**/*LMFP*
__pycache__/
*.pyc
*.egg-info/
.env
.DS_Store
*.log
# 个人学习过程记录只保留在本地，不上传到 GitHub
WEEKLY_REPORT.md

# 本地路线图/计划（2026-11-05），不进仓库
docs/ROADMAP.zh-CN.md

# GUI 校准工作台 [保存为配置] 的落盘文件（个人标定记录，本地保留；
# config.py 的内置条目仍走 CLI 模板人工复核登记）
src/xrd_toolkit/config_user.json

# 精修工作台 [存为仪器基线] 的落盘文件（2026-11-05；个人仪器参数，
# 本地保留，默认与 config_user.json 同目录）
src/xrd_toolkit/instrument_baseline.json

# 项目预设 [保存…] 的落盘文件（2026-11-10；个人项目路径/相库，本地保留）
src/xrd_toolkit/presets_user.json

# 掩膜检测参数按几何记忆（2026-11-11；个人探测器阈值，本地保留）
src/xrd_toolkit/mask_params.json

# PyInstaller 打包中间产物与成品（成品走 GitHub Release 附件，不进仓库）
build/
dist/

# Claude Code 本机设置（含完成提醒 hook），不进仓库
.claude/settings.local.json
